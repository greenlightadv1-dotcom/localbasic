# ---- Supabase (public: safe to expose to the browser) ----
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ---- Supabase (SERVER ONLY — never expose, never prefix with NEXT_PUBLIC_) ----
# Optional, but required for ONE feature: inviting a new workspace owner from
# Platform Admin → عميل جديد (/admin/onboard). Creating an auth account needs
# the Supabase Admin API, which the database cannot do on its own.
#
# Without it the site runs normally and /admin/onboard still provisions a
# workspace for an owner who ALREADY has an account; it says plainly that
# account creation is unconfigured rather than pretending to invite anyone.
#
# Also used by background workers and platform maintenance
# (createSupabaseAdminClient). Never prefix NEXT_PUBLIC_, never commit a value.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Application ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=LocalBasic

# ---- Public contact details (rendered into the marketing HTML) ----
# Both have the official values as defaults in src/config/site.ts, so a normal
# deployment needs neither. Set them only to point a staging or regional site
# at a different sales channel.
#
# The number is international format, digits only — wa.me rejects '+' or spaces.
NEXT_PUBLIC_WHATSAPP_NUMBER=201041165669
NEXT_PUBLIC_CONTACT_EMAIL=local.basic@greenlightadvs.com

# ---- Local development without a Supabase project ----
# Set to 1 to run against a local PostgreSQL through the development adapter
# (src/lib/supabase/local/). RLS still applies; only the transport changes.
# Ignored when NODE_ENV=production.
LOCALBASIC_LOCAL_DB=0
LOCAL_DATABASE_URL=

# ---- Rate limiting (optional; in-memory fallback used when unset) ----
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Notification worker (SERVER ONLY) ----
# The shared secret /api/worker/notifications compares against. Without it the
# route refuses every call rather than defaulting open, so a deployment that
# forgot to set it has a queue that does not run instead of one anybody can
# drive. Generate with: openssl rand -hex 32
NOTIFICATION_WORKER_SECRET=

# ---- Email delivery (SERVER ONLY) ----
# Both are required together. Without them the email channel has NO provider:
# the worker records those notifications as permanently failed, naming the
# channel, and never marks them sent. Nothing is ever reported as delivered
# that was not delivered.
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=
