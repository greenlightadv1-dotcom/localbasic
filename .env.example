# ---- Supabase (public: safe to expose to the browser) ----
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ---- Supabase (SERVER ONLY — never expose, never prefix with NEXT_PUBLIC_) ----
# Optional. Needed only by background workers and platform maintenance
# (createSupabaseAdminClient). The site runs without it.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Application ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=LocalBasic

# ---- Local development without a Supabase project ----
# Set to 1 to run against a local PostgreSQL through the development adapter
# (src/lib/supabase/local/). RLS still applies; only the transport changes.
# Ignored when NODE_ENV=production.
LOCALBASIC_LOCAL_DB=0
LOCAL_DATABASE_URL=

# ---- Rate limiting (optional; in-memory fallback used when unset) ----
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
