# ---- Supabase (public: safe to expose to the browser) ----
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ---- Supabase (SERVER ONLY — never expose, never prefix with NEXT_PUBLIC_) ----
# Used exclusively by workspace provisioning and background workers.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Application ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=LocalBasic

# ---- Rate limiting (optional; in-memory fallback used when unset) ----
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
